<% if object.errors.any? %>
  <div style="background: #ffebe9; border: 1px solid #ff8182; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
    <h3 style="color: #d1242f; margin-top: 0; font-size: 16px;">
      <%= pluralize(object.errors.count, "error") %> prohibited this from being saved:
    </h3>
    <ul style="color: #d1242f; margin-bottom: 0; padding-left: 20px;">
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>