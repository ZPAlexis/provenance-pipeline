<nav class="site-nav">
  <%= link_to "Provenance Pipeline", root_path, class: "brand" %>
  <%= nav_link "Dashboard", root_path, current: controller_name == "dashboard" %>
  <%= nav_link "Pipeline", applications_path, current: controller_name == "applications" %>
  <%= nav_link "Roles", roles_path, current: controller_name == "roles" %>
  <%= nav_link "Companies", companies_path, current: controller_name == "companies" %>
  <%= nav_link "Profile", profile_path, current: controller_name == "profiles" %>
  <% waiting = review_open_count %>
  <%= nav_link waiting.positive? ? "Review (#{waiting})" : "Review", review_path, current: controller_name == "review_items" %>
  <% refused = agents_refused_recently %>
  <%= nav_link refused.positive? ? "Agents (#{refused} refused)" : "Agents", agents_path,
               current: %w[agents agent_credentials].include?(controller_name) %>
  <span class="spacer"></span>
  <%= nav_link "About", about_path, current: controller_name == "pages" %>
</nav>
