    <summary><%= refused.positive? ? "Record (#{refused} refused)" : "Record" %></summary>
    <div class="menu-list">
      <%= nav_link "Audit log", audit_path, current: controller_name == "audit_events" %>
      <%= nav_link "Analytics", analytics_path, current: controller_name == "analytics" %>
