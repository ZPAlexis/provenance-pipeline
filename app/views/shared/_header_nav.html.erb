  <%= nav_link waiting.positive? ? "Review (#{waiting})" : "Review", review_path, current: controller_name == "review_items" %>
  <%# The record's own pages (4e): who did what, what changed, how it is going, and who may write what. %>
  <% refused = agents_refused_recently %>
  <details class="nav-menu<%= " current" if %w[audit_events analytics agents agent_credentials].include?(controller_name) %>"
