<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Role</th><th>Company</th><th>Location</th><th>Answer</th><th>Checked</th>
        <% if local_assigns[:fit] %><th>Why suggested</th><% else %><th>Own page</th><% end %>
        <th>Watch list</th>
      </tr>
    </thead>
    <tbody>
      <% roles.each do |role| %>
        <tr>
          <td><%= link_to role.role_title, role_path(role) %></td>
          <td><%= link_to role.company.name, company_path(role.company) %></td>
          <td class="muted"><%= role.location %></td>
          <td><%= answer_badge(role.verification_state) %></td>
          <td><%= ago(role.last_checked_at) %></td>
          <% if local_assigns[:fit] %>
            <td class="reason"><%= fit_reasons(role) %></td>
          <% else %>
            <td><%= outside_link(role.job_url, host_only: true) %></td>
          <% end %>
          <td><%= render "roles/watch", role: role %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
