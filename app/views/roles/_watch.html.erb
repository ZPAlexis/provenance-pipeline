<%# Track or archive a role ("dismiss", the stored word), with a note: it becomes the reason on the audit record. Opening one hides
    its button and the other's (one decision at a time); Cancel puts them back. %>
<% actions = { "tracked" => %i[dismiss], "dismissed" => %i[track], "suggested" => %i[track dismiss] }.fetch(role.tracking, []) %>
<div class="watch">
  <% actions.each do |action| %>
    <details data-controller="fold">
      <summary class="btn small"><%= action == :track ? "Track" : "Archive" %></summary>
      <%= form_with url: (action == :track ? track_role_path(role) : dismiss_role_path(role)), method: :patch,
                    class: "watch-form" do |form| %>
        <%= form.text_field :note, required: true, autocomplete: "off", "aria-label": "Why",
                                   placeholder: action == :track ? "Why track it?" : "Why archive it? (never checked again)" %>
        <div class="button-row">
          <%= form.submit action == :track ? "Track" : "Archive", class: [ "btn", "small", ("primary" if action == :track) ] %>
          <button type="button" class="btn small quiet" data-action="fold#close">Cancel</button>
        </div>
      <% end %>
    </details>
  <% end %>
</div>
