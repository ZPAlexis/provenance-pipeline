<%# How well this role fits you (2f): its newest score, weighed from its description, and the ones before it. Read two
    ways since 4c: the ATS fit, your resume alone as a recruiter's screening system would read it, and the Background
    fit beside it, read with your background too. Weighed only when you ask; what it costs is asked first. %>
<% resume = SearchProfile.current&.resumes&.newest_first&.first %>
<% background = SearchProfile.current&.backgrounds&.newest_first&.first %>
<section class="check-now">
  <% if fit %>
    <% score = fit.score %>
    <h3>ATS fit</h3>
    <p class="fit-head"><%= fit_badge(score.score) %> <span class="muted small">of 100</span> <%= score.why %></p>
    <p class="muted small">Your resume alone, as a recruiter's screening system would read it.</p>
    <% if score.level %><p class="small"><span class="muted">Level:</span> <%= score.level %></p><% end %>
    <div class="fit-lists">
      <div>
        <p class="small"><strong>What it asks that your resume shows</strong></p>
        <% if score.matches.any? %>
          <ul class="small drew-on">
            <% score.matches.each do |match| %>
              <li><%= match["point"] %>
                <% match["lines"].each do |line| %><br><span class="muted">[<%= line["line"] %>] <%= line["text"] %></span><% end %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="muted small">Nothing it found.</p>
        <% end %>
      </div>
      <div>
        <p class="small"><strong>What it asks that your resume doesn't show</strong></p>
        <% if score.gaps.any? %>
          <ul class="small drew-on">
            <% score.gaps.each do |gap| %><li><strong><%= gap["asks"] %></strong>: <%= gap["note"] %></li><% end %>
          </ul>
        <% else %>
          <p class="muted small">Nothing it found.</p>
        <% end %>
      </div>
    </div>
    <% if score.dropped_lines.positive? %>
      <p class="small warn">It named <%= pluralize(score.dropped_lines, "line") %> your resume doesn't have; they were left out.</p>
    <% end %>
    <% call = score.llm_call %>
    <p class="muted small">
      Weighed <%= ago(score.created_at) %> by <%= score.writer %><%= " with #{call.model} for #{cost(call.cost_usd)}" if call %>,
      from your resume <%= score.resume ? "saved #{score.resume.created_at.to_date}" : "(since deleted)" %> and its description
      <%= score.role_description ? "read #{score.role_description.first_read_at.to_date}" : "(no longer on record)" %>.
      Advice for ranking roles: it claims nothing for you.
    </p>
    <% if fit.stale? %>
      <p class="small warn"><%= fit.stale.to_sentence.upcase_first %> changed since it was weighed: weigh it again for a current score.</p>
    <% end %>
    <% if earlier.any? %>
      <p class="muted small">
        Before: <%= safe_join(earlier.map { |before| "#{before.score}#{" (Background fit #{before.background_score})" if before.background_reading?} on #{before.created_at.to_date}" }, ", ") %>.
      </p>
    <% end %>

    <h3 id="background-fit">Background fit</h3>
    <% if score.background_reading? %>
      <p class="fit-head"><%= fit_badge(score.background_score) %> <span class="muted small">of 100</span> <%= score.background_why %></p>
      <p class="muted small">With your background too: what you're looking for, your role preferences, and what isn't on your resume.</p>
      <div class="fit-lists">
        <div>
          <p class="small"><strong>Gaps your background covers</strong></p>
          <% if score.covered.any? %>
            <ul class="small drew-on">
              <% score.covered.each do |gap| %>
                <li><strong><%= gap["asks"] %></strong>: address it in <%= FitScore::ADDRESS_IN.fetch(gap["address_in"], gap["address_in"]) %><%= ". #{gap['note']}" if gap["note"] %>
                  <% gap["lines"].each do |line| %><br><span class="muted">[B<%= line["line"] %>] <%= line["text"] %></span><% end %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="muted small">None: what the resume doesn't show, the background doesn't either.</p>
          <% end %>
        </div>
        <div>
          <p class="small"><strong>Your role preferences</strong></p>
          <% if score.preferences.any? %>
            <ul class="small drew-on">
              <% score.preferences.each do |point| %>
                <li><%= tag.span(point["verdict"] == "match" ? "met" : "missed", class: [ "badge", point["verdict"] == "match" ? "live" : "gone" ]) %>
                  <%= point["preference"] %><%= ": #{point['why']}" if point["why"] %>
                  <% point["lines"].each do |line| %><br><span class="muted">[B<%= line["line"] %>] <%= line["text"] %></span><% end %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="muted small">None the role touches.</p>
          <% end %>
        </div>
      </div>
      <% if score.background_dropped_lines.positive? %>
        <p class="small warn">It named <%= pluralize(score.background_dropped_lines, "background line") %> your background doesn't have; they were left out.</p>
      <% end %>
      <p class="muted small">
        Read with your background <%= score.background ? "saved #{score.background.created_at.to_date} (version #{score.background.version})" : "(since deleted)" %>.
      </p>
      <% if fit.background_stale %>
        <p class="small warn">Your background changed since: weigh it again for a current Background fit.</p>
      <% end %>
    <% elsif background %>
      <p class="muted small">
        Before your background: weighed from your resume alone. Weigh it again below, or ask your Claude client to ("Weigh my
        roles", before your background), for a Background fit beside this one.
      </p>
    <% else %>
      <p class="muted small">Save your <%= link_to "background", profile_path(anchor: "background") %> on the Profile page for a Background fit beside this one.</p>
    <% end %>
  <% end %>

  <% if resume.nil? %>
    <p class="muted small">Weighing its fit needs your resume, saved on <%= link_to "the Profile page", profile_path(anchor: "resume") %>.</p>
  <% elsif role.job_url.blank? && descriptions.empty? %>
    <p class="muted small">No description to weigh it from: it has no page of its own to read one from.</p>
  <% elsif !run&.active? %>
    <% estimate = FitScores.estimate %>
    <%= form_with url: fit_scores_path, class: "check-form",
                  data: { turbo_confirm: "Haiku 4.5 weighs it against your resume#{', its description read first (free)' if descriptions.empty?}: " \
                                         "about #{cost(estimate)}. Weigh it?" } do |form| %>
      <%= hidden_field_tag :posting_id, role.id %>
      <%= form.submit fit ? "Weigh it again" : "Weigh its fit", class: "btn small" %>
      <span class="muted small">
        Haiku 4.5 weighs it from <%= descriptions.empty? ? "its description (read first, free)" : "its description" %> and your resume,
        claiming only what your resume shows<%= background ? ", then again with your background for the Background fit" : "" %>: about <%= cost(estimate) %>.
      </span>
    <% end %>
  <% end %>
  <%# The latest weighing, while it runs (this role's, or a batch's) or when it weighed nothing (why not). %>
  <%= render "check_runs/run", run: run, poll: false if run && (run.active? || run.answer != "weighed") %>
</section>
