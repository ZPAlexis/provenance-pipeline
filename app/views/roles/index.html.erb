<% content_for :title, "Roles · Provenance Pipeline" %>
<div class="page-head">
  <div>
    <h1>Roles</h1>
    <p class="sub">Every role is checked at the employer's own careers page. Only you track or archive one.</p>
  </div>
  <div class="head-actions">
    <% if @tab == "suggested" %>
      <%= button_to "Find suggestions", suggestions_path, class: "btn",
                    title: "Weigh every watched company's latest list against your search profile. Costs nothing.",
                    data: { turbo_submits_with: "Weighing roles…" } %>
    <% end %>
    <% if @tab != "dismissed" && @unscored.any? && !@fit_run&.active? %>
      <% to_read = FitScores.undescribed(@unscored).size %>
      <%= button_to "Weigh #{pluralize(@unscored.size, 'unscored role')}", fit_scores_path, class: "btn",
                    title: "Weigh each tracked or suggested role with no current score against your resume, from its description.",
                    form: { data: { turbo_confirm: "Haiku 4.5 weighs #{pluralize(@unscored.size, 'role')} against your resume, one call each" \
                                                   "#{", #{to_read} #{to_read == 1 ? 'description' : 'descriptions'} read first (free)" if to_read.positive?}: " \
                                                   "about #{cost(FitScores.estimate * @unscored.size)}. It runs in the background. Weigh them?" } } %>
    <% end %>
  </div>
</div>
<%= render "check_runs/run", run: @fit_run, poll: false if @fit_run %>

<details class="add" <%= "open" if params[:add] %>>
  <summary class="btn">Add a role</summary>
  <%= render "roles/add_form", company: nil %>
</details>

<nav class="tabs">
  <% RolesController::TABS.each do |tab| %>
    <%= link_to roles_path(tab: tab, q: @q), class: ("current" if tab == @tab) do %>
      <%= tracking_label(tab).capitalize %> <span class="count"><%= @counts.fetch(tab, 0) %></span>
    <% end %>
  <% end %>
</nav>

<%= render "shared/find", url: roles_path, keep: { tab: @tab, answer: @answer }, value: @q,
                          clear: roles_path(tab: @tab, answer: @answer), placeholder: "Title, company, or place" %>

<nav class="filters" aria-label="Filter by answer">
  <%= link_to roles_path(tab: @tab, q: @q), class: [ "filter", ("current" if @answer.nil?) ] do %>
    All <span class="count"><%= @answer_counts.values.sum %></span>
  <% end %>
  <% RolesController::ANSWERS.each do |state| %>
    <%= link_to roles_path(tab: @tab, answer: state, q: @q),
                class: [ "filter", answer_tone(state), ("current" if state == @answer) ] do %>
      <%= answer_label(state) %> <span class="count"><%= @answer_counts.fetch(state, 0) %></span>
    <% end %>
  <% end %>
</nav>

<% if @fits.any? || @fit %>
  <nav class="filters" aria-label="Filter by fit">
    <span class="muted small">Fit:</span>
    <%= link_to roles_path(tab: @tab, answer: @answer, q: @q, sort: @sort), class: [ "filter", ("current" if @fit.nil?) ] do %>
      Any
    <% end %>
    <% RolesController::FITS.each do |key, label| %>
      <%= link_to roles_path(tab: @tab, answer: @answer, q: @q, fit: key, sort: @sort), class: [ "filter", ("current" if key == @fit) ] do %>
        <%= label %> <span class="count"><%= @fit_counts.fetch(key, 0) %></span>
      <% end %>
    <% end %>
  </nav>
<% end %>

<% if @roles.any? %>
  <% bulk = @tab != "dismissed" %>
  <%= tag.div(data: { controller: ("bulk" if bulk) }) do %>
    <% if bulk %>
      <%= form_with url: dismiss_many_roles_path, method: :patch, id: "bulk-dismiss", class: "bulk-form",
                    data: { turbo_confirm: "Archive the selected roles? They are never checked or suggested again, until you track one by hand." } do |form| %>
        <span class="muted small" data-bulk-target="count">None selected</span>
        <%= form.text_field :note, required: true, autocomplete: "off", "aria-label": "Why archive them",
                                   placeholder: "Why archive them?" %>
        <%= form.submit "Archive selected", class: "btn small", disabled: true, data: { bulk_target: "submit" } %>
      <% end %>
    <% end %>
    <%= render "table", roles: @roles, fit: @tab == "suggested", bulk: bulk, fits: @fits,
                        sort: roles_path(tab: @tab, answer: @answer, q: @q, fit: @fit, sort: (@sort ? nil : "fit")), sorted: @sort %>
  <% end %>
<% elsif @fit %>
  <p class="empty">No <%= @tab %> role listed here is <%= RolesController::FITS.fetch(@fit).downcase %>.</p>
<% elsif @q %>
  <p class="empty">No <%= @tab %> role<%= " #{answer_label(@answer).downcase}" if @answer %> matches “<%= @q %>”.</p>
<% elsif @answer %>
  <p class="empty">No <%= @tab %> role is <%= answer_label(@answer).downcase %>.</p>
<% else %>
  <p class="empty">
    <%= { "suggested" => "No suggestions yet. Save your search profile, or press Find suggestions: roles on watched pages that fit it land here.",
          "dismissed" => "No role archived." }.fetch(@tab, "No role tracked.") %>
  </p>
<% end %>
