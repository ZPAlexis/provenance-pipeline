<% content_for :title, "Roles · Provenance Pipeline" %>
<div class="page-head">
  <div>
    <h1>Roles</h1>
    <p class="sub">Every role is checked at the employer's own careers page. Only you decide which to track or archive.</p>
  </div>
  <div class="head-actions">
    <% if @tab == "suggested" %>
      <%= button_to "Find suggestions", suggestions_path, class: "btn",
                    title: "Weigh every watched company's latest list against your search profile. Costs nothing.",
                    data: { turbo_submits_with: "Weighing roles…" } %>
    <% end %>
    <% if @tab != "dismissed" && @before_background_roles.any? && !@fit_run&.active? %>
      <%= button_to "Weigh again #{pluralize(@before_background_roles.size, 'role')} weighed before your background", fit_scores_path,
                    params: { before_background: 1 }, class: "btn",
                    title: "Weigh each again, its ATS fit and its Background fit, with your background as it is now.",
                    form: { data: { turbo_confirm: "Haiku 4.5 weighs #{pluralize(@before_background_roles.size, 'role')} again, the ATS fit and the " \
                                                   "Background fit, one call each: about #{cost(FitScores.estimate * @before_background_roles.size)}. " \
                                                   "It runs in the background. Weigh them?" } } %>
    <% end %>
    <% if @tab != "dismissed" && @before_screen_roles.any? && !@fit_run&.active? %>
      <%= button_to "Weigh again #{pluralize(@before_screen_roles.size, 'role')} weighed before the screen check", fit_scores_path,
                    params: { before_screen: 1 }, class: "btn",
                    title: "Weigh each again, its must-haves read one by one: one not on your resume caps the ATS fit.",
                    form: { data: { turbo_confirm: "Haiku 4.5 weighs #{pluralize(@before_screen_roles.size, 'role')} again, its " \
                                                   "must-haves read one by one, one call each: about " \
                                                   "#{cost(FitScores.estimate * @before_screen_roles.size)}. It runs in the background. Weigh them?" } } %>
    <% end %>
    <% if @tab != "dismissed" && @unscored.any? && !@fit_run&.active? %>
      <% to_read = FitScores.undescribed(@unscored).size %>
      <%= button_to "Weigh #{pluralize(@unscored.size, 'unscored role')}", fit_scores_path, class: "btn",
                    title: "Weigh each tracked or suggested role with no current score against your resume, from its description.",
                    form: { data: { turbo_confirm: "Haiku 4.5 weighs #{pluralize(@unscored.size, 'role')} against your resume, one call each" \
                                                   "#{", #{to_read} #{to_read == 1 ? 'description' : 'descriptions'} read first (free)" if to_read.positive?}: " \
                                                   "about #{cost(FitScores.estimate * @unscored.size)}. It runs in the background. Weigh them?" } } %>
    <% end %>
  </div>
</div>
<% unless @tab == "dismissed" %>
  <%= turbo_frame_tag "check_all", src: check_all_path do %>
    <p class="muted small"><span class="spinner" aria-hidden="true"></span> Working out what a check of all tracked companies would read and cost…</p>
  <% end %>
<% end %>
<%= render "check_runs/run", run: @fit_run, poll: false if @fit_run %>

<%# One row (4e): the tabs, then finding and adding; the filters and the order below, applied as soon as one changes. %>
<div class="list-toolbar">
  <nav class="tabs">
    <% RolesController::TABS.each do |tab| %>
      <%= link_to roles_path(tab: tab, q: @q), class: ("current" if tab == @tab) do %>
        <%= tracking_label(tab).capitalize %> <span class="count"><%= @counts.fetch(tab, 0) %></span>
      <% end %>
    <% end %>
  </nav>
  <div class="toolbar-tools">
    <%= render "shared/find", url: roles_path, keep: { tab: @tab, answer: @answer, fit: @fit, sort: @sort }, value: @q,
                              clear: roles_path(tab: @tab, answer: @answer, fit: @fit, sort: @sort), placeholder: "Title, company, or place" %>
    <details class="add" <%= "open" if params[:add] %>>
      <summary class="btn primary">Add a role</summary>
      <%= render "roles/add_form", company: nil %>
    </details>
  </div>
</div>

<%= form_with url: roles_path, method: :get, class: "list-filters", data: { controller: "autosubmit" }, "aria-label": "Narrow and order the list" do %>
  <%= hidden_field_tag :tab, @tab, id: nil %>
  <%= hidden_field_tag :q, @q, id: nil if @q %>
  <label>
    <span class="muted small">Listing</span>
    <%= select_tag :answer, options_for_select([ [ "Any (#{@answer_counts.values.sum})", "" ] ] +
                                               RolesController::ANSWERS.map { |state| [ "#{answer_label(state)} (#{@answer_counts.fetch(state, 0)})", state ] }, @answer),
                   id: nil, data: { action: "autosubmit#submit" } %>
  </label>
  <% if @fits.any? || @fit %>
    <% fits = RolesController::FITS.reject do |key, _|
         (key == "before_background" && !@background && key != @fit) || (key == "before_screen" && @fit_counts.fetch(key, 0).zero? && key != @fit)
       end %>
    <label title="The ATS fit: your resume alone, as a recruiter's screening system would read it">
      <span class="muted small">ATS fit</span>
      <%= select_tag :fit, options_for_select([ [ "Any", "" ] ] + fits.map { |key, label| [ "#{label} (#{@fit_counts.fetch(key, 0)})", key ] }, @fit),
                     id: nil, data: { action: "autosubmit#submit" } %>
    </label>
  <% end %>
  <label>
    <span class="muted small">Order</span>
    <%= select_tag :sort, options_for_select([ [ "Application, fit, last checked", "" ] ] + RolesController::SORTS.map { |key, label| [ label, key ] }, @sort),
                   id: nil, data: { action: "autosubmit#submit" } %>
  </label>
  <noscript><button type="submit" class="btn small">Apply</button></noscript>
<% end %>

<% if @roles.any? %>
  <% bulk = @tab != "dismissed" %>
  <%= tag.div(data: { controller: ("bulk" if bulk) }) do %>
    <% if bulk %>
      <%= form_with url: dismiss_many_roles_path, method: :patch, id: "bulk-dismiss", class: "bulk-form",
                    data: { turbo_confirm: "Archive the selected roles? They are never checked or suggested again, until you track one again." } do |form| %>
        <span class="small" data-bulk-target="count">None selected</span>
        <%= form.text_field :note, required: true, autocomplete: "off", "aria-label": "Why archive them",
                                   placeholder: "Why archive them?" %>
        <%= form.submit "Archive selected", class: "btn", disabled: true, data: { bulk_target: "submit" } %>
      <% end %>
    <% end %>
    <%= render "table", roles: @roles, fit: @tab == "suggested", bulk: bulk, fits: @fits, company_fits: @company_fits, profile: @profile,
                        sorts: ->(key) { roles_path(tab: @tab, answer: @answer, q: @q, fit: @fit, sort: (@sort == key ? nil : key)) },
                        sorted: @sort %>
  <% end %>
<% elsif @fit %>
  <p class="empty">
    No <%= @tab %> role listed here <%= { "before_background" => "was weighed before your background as it is now",
                                          "before_screen" => "was weighed before the screen check" }.fetch(@fit) { "is #{RolesController::FITS.fetch(@fit).downcase}" } %>.
  </p>
<% elsif @q %>
  <p class="empty">No <%= @tab %> role<%= " #{answer_label(@answer).downcase}" if @answer %> matches “<%= @q %>”.</p>
<% elsif @answer %>
  <p class="empty">No <%= @tab %> role is <%= answer_label(@answer).downcase %>.</p>
<% else %>
  <p class="empty">
    <%= { "suggested" => "No suggestions yet. Save your search profile, or press Find suggestions: roles on watched pages that fit it land here.",
          "dismissed" => "No role archived." }.fetch(@tab, "No role tracked.") %>
  </p>
<% end %>
