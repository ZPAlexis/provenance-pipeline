<% content_for :title, "Roles · Provenance Pipeline" %>
<div class="page-head">
  <div>
    <h1>Roles</h1>
    <p class="sub">Every role is checked at the employer's own careers page. Only you track or dismiss one.</p>
  </div>
  <% if @tab == "suggested" %>
    <%= button_to "Find suggestions", suggestions_path, class: "btn",
                  title: "Weigh every watched company's latest list against your search profile. Costs nothing.",
                  data: { turbo_submits_with: "Weighing roles…" } %>
  <% end %>
</div>

<details class="add" <%= "open" if params[:add] %>>
  <summary class="btn">Add a role</summary>
  <% ceiling = Verifier::CheckNow.ceiling(Company.new) + Verifier::CheckNow.average_read %>
  <%= form_with url: roles_path, class: "add-form",
                data: { turbo_confirm: "Adding it checks the role right away: its own page first, free on an ATS; at most " \
                                       "#{cost(ceiling)} when its title must be read by the AI or its company is new. Add it?" } do |form| %>
    <label>Its own page <%= form.text_field :link, required: true, placeholder: "acme.com/careers/jobs/123, or its ATS posting" %></label>
    <label>
      <span>Title <span class="muted">(optional: read from its page)</span></span>
      <%= form.text_field :title, placeholder: "Solutions Engineer" %>
    </label>
    <label>
      <span>Location <span class="muted">(optional)</span></span>
      <%= form.text_field :location, placeholder: "São Paulo, Brazil" %>
    </label>
    <label>
      <span>Where you found it <span class="muted">(optional)</span></span>
      <%= form.text_field :source, placeholder: "linkedin.com/jobs/view/…" %>
    </label>
    <label>
      <span>Company <span class="muted">(optional, if new)</span></span>
      <%= form.text_field :company_name, placeholder: "Acme" %>
    </label>
    <%= form.submit "Add and check", class: "btn primary" %>
    <p class="muted small">
      Tracked: pasting a role is choosing it, even one you dismissed. Its own page is checked first; its company's
      careers page is found first if it has none. Left blank, its title (and location) come from what is read: free
      on an ATS; elsewhere its page's heading, and one AI read only when that is unclear. A job board's link (LinkedIn, Indeed) is never read: keep it in
      "Where you found it", where it also finds a role already on record.
    </p>
  <% end %>
</details>

<nav class="tabs">
  <% RolesController::TABS.each do |tab| %>
    <%= link_to roles_path(tab: tab), class: ("current" if tab == @tab) do %>
      <%= tab.capitalize %> <span class="count"><%= @counts.fetch(tab, 0) %></span>
    <% end %>
  <% end %>
</nav>

<nav class="filters" aria-label="Filter by answer">
  <%= link_to roles_path(tab: @tab), class: [ "filter", ("current" if @answer.nil?) ] do %>
    All <span class="count"><%= @answer_counts.values.sum %></span>
  <% end %>
  <% RolesController::ANSWERS.each do |state| %>
    <%= link_to roles_path(tab: @tab, answer: state),
                class: [ "filter", answer_tone(state), ("current" if state == @answer) ] do %>
      <%= answer_label(state) %> <span class="count"><%= @answer_counts.fetch(state, 0) %></span>
    <% end %>
  <% end %>
</nav>

<% if @roles.any? %>
  <%= render "table", roles: @roles, fit: @tab == "suggested" %>
<% elsif @answer %>
  <p class="empty">No <%= @tab %> role is <%= answer_label(@answer).downcase %>.</p>
<% else %>
  <p class="empty">
    <%= { "suggested" => "No suggestions yet. Save your search profile, or press Find suggestions: roles on watched pages that fit it land here.",
          "dismissed" => "No role dismissed." }.fetch(@tab, "No role tracked.") %>
  </p>
<% end %>
