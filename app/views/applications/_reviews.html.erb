<%# An application's resume reviews (2d): your resume weighed against the role, written in the app by the drafter
    (on the API) or saved by your AI assistant through MCP (on your subscription). Advice for you: nothing in
    them is sent or claimed. %>
<% resume = SearchProfile.current&.resumes&.newest_first&.first %>
<% description = application.posting.role_descriptions.newest_first.first %>
<% background = SearchProfile.current&.backgrounds&.newest_first&.first %>
<h2 id="reviews">Resume reviews</h2>
<% needs = Drafts.missing(application) %>
<section class="check-now">
  <% if needs.any? %>
    <p class="muted small">Reviewing needs <%= needs.to_sentence %> first.</p>
  <% elsif !run&.active? %>
    <% estimate = ResumeReviews.estimate %>
    <%= form_with url: application_resume_reviews_path(application), class: "add-form",
                  data: { turbo_confirm: "Opus 5.5 reviews your resume against the role: about #{cost(estimate)}. Review it?" } do |form| %>
      <label>Language <%= text_field_tag :language, nil, id: "review_language", list: "review-languages", placeholder: "English",
                                                         maxlength: Drafts::MAX_LANGUAGE, autocomplete: "off" %></label>
      <datalist id="review-languages"><% %w[English Portuguese Spanish].each do |language| %><option value="<%= language %>"></option><% end %></datalist>
      <%= form.submit "Review my resume", class: "btn small" %>
      <p class="muted small">
        Opus 5.5 weighs your resume against the role's description: strengths with the lines behind them, gaps, suggestions;
        about <%= cost(estimate) %>. Or ask your AI assistant for one through MCP (the Resume review prompt), on your
        subscription: it saves it here when you tell it to.
      </p>
    <% end %>
  <% end %>
  <%# The latest run, while it writes or when it wrote nothing (why not); a review it wrote shows below. %>
  <%= render "check_runs/run", run: run, poll: false if run && (run.active? || run.answer != "reviewed") %>
</section>
<% newest, *earlier = reviews %>
<%= render "applications/review", review: newest, application: application, resume: resume, description: description, background: background if newest %>
<% if earlier.any? %>
  <details class="earlier">
    <summary class="muted small"><%= pluralize(earlier.size, "earlier review") %></summary>
    <% earlier.each do |review| %>
      <%= render "applications/review", review: review, application: application, resume: resume, description: description, background: background %>
    <% end %>
  </details>
<% end %>
