<% role = @application.posting %>
<% content_for :title, "#{role.role_title} · Pipeline · Provenance Pipeline" %>
<%# Its forms redirect back here: keep the reader's place, and the notice in view. %>
<% turbo_refreshes_with method: :replace, scroll: :preserve %>
<% content_for :floating_flash, true %>
<div class="page-head">
  <div>
    <p class="muted small"><%= link_to "Pipeline", applications_path %> / Application</p>
    <h1><%= link_to role.role_title, role_path(role) %></h1>
    <p class="sub"><%= link_to @application.company.name, company_path(@application.company) %><%= " · #{role.location}" if role.location %></p>
  </div>
  <div><%= stage_badge(@application.stage) %></div>
</div>

<nav class="stage-path" aria-label="Where it stands">
  <% stage_path(@application, @timeline).each do |step| %>
    <%= link_to step.label, application_path(@application, stage: step.stage, anchor: "move"), class: step.state,
                            title: step.state == "current" ? "Where it stands now" : "Move it here" %>
  <% end %>
</nav>

<dl class="facts">
  <dt>Stage</dt>
  <dd><%= Application.stage_label(@application.stage) %>, <%= in_stage(@application) %> (since <%= @application.stage_changed_on %>)</dd>
  <dt>The role</dt>
  <dd><%= answer_badge(role.verification_state) %><%= ", checked " if role.last_checked_at %><%= ago(role.last_checked_at) if role.last_checked_at %></dd>
  <dt>Description</dt>
  <dd>
    <% if (description = role.role_descriptions.newest_first.first) %>
      <%= number_with_delimiter(description.words) %> words, read <%= description.first_read_at.to_date %> · <%= link_to "read it on the role's page", role_path(role) %>
    <% else %>
      <span class="muted">not read yet</span> · <%= link_to "the role's page", role_path(role) %> reads it
    <% end %>
  </dd>
  <dt>Resume reviews</dt>
  <dd>
    <%= @reviews.any? ? pluralize(@reviews.size, "review") : tag.span("none yet", class: "muted") %>
    · <%= link_to @reviews.any? ? "see them" : "how to write one", "#reviews" %>
  </dd>
  <dt>Drafts</dt>
  <dd>
    <% approved = @drafts.count(&:approved?) %>
    <%= @drafts.any? ? "#{pluralize(@drafts.size, 'draft')}#{", #{approved} approved" if approved.positive?}" : tag.span("none yet", class: "muted") %>
    · <%= link_to @drafts.any? ? "see them" : "write one", "#drafts" %>
  </dd>
</dl>

<h2 id="move">Move it</h2>
<%= form_with url: move_application_path(@application), method: :patch, class: "add-form" do |form| %>
  <label>To <%= select_tag :stage, stage_options(Application::STAGES.include?(params[:stage]) ? params[:stage] : @application.stage) %></label>
  <label>On <%= form.date_field :on, value: Date.current, max: Date.current %></label>
  <label>Note <%= form.text_field :note, placeholder: "Recruiter call booked", autocomplete: "off" %></label>
  <%= form.submit "Move", class: "btn primary small" %>
  <p class="muted small">Yours alone: no agent can move an application. The date is when it happened; a correction is fine.</p>
<% end %>

<h2>Log what happened</h2>
<%= form_with url: log_application_path(@application), class: "add-form" do |form| %>
  <label>What <%= select_tag :kind, activity_options %></label>
  <label>On <%= form.date_field :on, value: Date.current %></label>
  <label>Summary <%= form.text_field :summary, required: true, placeholder: "Wrote to the recruiter", autocomplete: "off" %></label>
  <%= form.submit "Log it", class: "btn small" %>
<% end %>

<h2>Timeline</h2>
<% if @timeline.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>On</th><th>What</th><th>By</th><th>Note</th><th></th></tr></thead>
      <tbody>
        <% @timeline.each do |entry| %>
          <tr>
            <td class="nowrap"><%= entry.on %></td>
            <td class="nowrap">
              <% if entry.stage %>
                <%= entry.from ? "#{Application.stage_label(entry.from)} → " : "Started at " %><%= stage_badge(entry.stage) %>
              <% else %>
                <span class="badge"><%= entry.activity.kind.humanize %></span>
              <% end %>
            </td>
            <td><%= actor_label(entry.actor) %></td>
            <td class="reason"><%= entry.note %></td>
            <td class="nowrap">
              <% if (activity = entry.activity) %>
                <details class="row-edit">
                  <summary class="btn small">Edit</summary>
                  <%= form_with url: application_activity_path(@application, activity), method: :patch, class: "add-form" do |form| %>
                    <label>What <%= select_tag :kind, activity_options(activity.kind) %></label>
                    <label>On <%= form.date_field :on, value: activity.occurred_on %></label>
                    <label>Summary <%= form.text_field :summary, value: activity.summary, required: true, autocomplete: "off" %></label>
                    <%= form.submit "Save", class: "btn primary small" %>
                  <% end %>
                </details>
                <%= button_to "Delete", application_activity_path(@application, activity), method: :delete, class: "btn small",
                                                                                            data: { turbo_confirm: "Delete this activity from the timeline?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">Nothing yet.</p>
<% end %>

<h2 id="notes">Notes and pay expectation</h2>
<%= form_with url: note_application_path(@application), method: :patch, class: "add-form" do |form| %>
  <label>Pay expectation <%= form.text_field :comp_expectation, value: @application.comp_expectation, placeholder: "e.g. 25k a month",
                                                                 autocomplete: "off" %></label>
  <label class="wide">Notes <%= form.text_area :notes, value: @application.notes, rows: 4,
                                                       placeholder: "Who you spoke to, what matters to them, what to ask next" %></label>
  <%= form.submit "Save notes", class: "btn small" %>
<% end %>

<%= render "reviews", application: @application, reviews: @reviews, run: @review_run %>

<%= render "drafts", application: @application, drafts: @drafts, run: @draft_run %>
