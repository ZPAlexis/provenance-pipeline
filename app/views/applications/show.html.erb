<% role = @application.posting %>
<% company_contacts = @application.company.contacts.to_a %>
<% content_for :title, "#{role.role_title} · Pipeline · Provenance Pipeline" %>
<%# Its forms redirect back here: keep the reader's place, and the notice in view. %>
<% turbo_refreshes_with method: :replace, scroll: :preserve %>
<% content_for :floating_flash, true %>
<%# An application's page (4e): where it stands, the role's fits and its company's, so the work happens here; then tabs:
    what happened, the fit, the writing, the people, your notes, and every change. %>
<% score = @fit&.score %>
<div class="page-head">
  <div>
    <p class="muted small"><%= link_to "Pipeline", applications_path %> / Application</p>
    <h1><%= link_to role.role_title, role_path(role) %></h1>
    <p class="sub"><%= link_to @application.company.name, company_path(@application.company) %><%= " · #{role.location}" if role.location %></p>
    <p class="fit-strip">
      <%= stage_badge(@application.stage) %> <%= answer_badge(role.verification_state) %>
      <span class="fit-strip-item"><span class="muted small">ATS fit</span> <%= score ? link_to(fit_badge(score.score), "#fit") : tag.span("—", class: "muted", title: "Not weighed yet") %></span>
      <% if score&.background_reading? %>
        <span class="fit-strip-item"><span class="muted small">Background fit</span> <%= link_to fit_badge(score.background_score), "#background-fit" %></span>
      <% end %>
      <span class="fit-strip-item"><span class="muted small">Company fit</span> <%= company_fit_cell(@company_review, @profile) %></span>
    </p>
    <% if score&.screened? && score.screen_risks.any? %>
      <p class="small warn">Likely screened out on: <%= score.screen_risks.map { |must| must["asks"] }.to_sentence %>.</p>
    <% end %>
  </div>
  <div class="page-actions">
    <%= link_to "Move it", "#move", class: "btn primary" %>
    <%= link_to "Log what happened", "#log", class: "btn" %>
  </div>
</div>

<nav class="stage-path" aria-label="Where it stands">
  <% stage_path(@application, @timeline).each do |step| %>
    <%= link_to step.label, application_path(@application, stage: step.stage, anchor: "move"), class: step.state,
                            title: step.state == "current" ? "Where it stands now" : "Move it here" %>
  <% end %>
</nav>

<dl class="facts overview">
  <dt>Stage</dt>
  <dd><%= Application.stage_label(@application.stage) %>, <%= in_stage(@application) %> (since <%= @application.stage_changed_on %>)</dd>
  <dt>Listing</dt>
  <dd><%= answer_label(role.verification_state) %><%= ", checked " if role.last_checked_at %><%= ago(role.last_checked_at) if role.last_checked_at %></dd>
  <dt>Description</dt>
  <dd>
    <% if (description = role.role_descriptions.newest_first.first) %>
      <%= number_with_delimiter(description.words) %> words, read <%= description.first_read_at.to_date %> · <%= link_to "read it on the role's page", role_path(role) %>
    <% else %>
      <span class="muted">not read yet</span> · <%= link_to "the role's page", role_path(role) %> reads it
    <% end %>
  </dd>
  <dt>Writing</dt>
  <dd>
    <% approved = @drafts.count(&:approved?) %>
    <%= @reviews.any? ? pluralize(@reviews.size, "resume review") : tag.span("no resume review", class: "muted") %>,
    <%= @drafts.any? ? "#{pluralize(@drafts.size, 'draft')}#{", #{approved} approved" if approved.positive?}" : tag.span("no draft", class: "muted") %>
    · <%= link_to "see them", "#writing" %>
  </dd>
</dl>

<div data-controller="tabs">
<%= page_tabs([ [ "activity", "Activity" ], [ "fit", "Fit" ], [ "writing", "Writing" ], [ "contacts", "Contacts" ],
                [ "notes", "Notes" ], [ "history", "History" ] ], label: "This application") %>

<%= tab_panel "activity", first: true do %>
<h3 id="move">Move it</h3>
<%= form_with url: move_application_path(@application), method: :patch, class: "add-form" do |form| %>
  <label>To <%= select_tag :stage, stage_options(Application::STAGES.include?(params[:stage]) ? params[:stage] : @application.stage) %></label>
  <label>On <%= form.date_field :on, value: Date.current, max: Date.current %></label>
  <label>Note <%= form.text_field :note, placeholder: "Recruiter call booked", autocomplete: "off" %></label>
  <%= form.submit "Move", class: "btn primary small" %>
  <p class="muted small">Yours alone: no agent can move an application. The date is when it happened; a correction is fine.</p>
<% end %>

<h3 id="log">Log what happened</h3>
<%= form_with url: log_application_path(@application), class: "add-form" do |form| %>
  <label>What <%= select_tag :kind, activity_options %></label>
  <label>On <%= form.date_field :on, value: Date.current %></label>
  <% if company_contacts.any? %>
    <label>With <%= select_tag :contact_id, options_for_select(company_contacts.map { |contact| [ contact.label, contact.id ] }),
                                include_blank: "(no one in particular)", id: "log_contact" %></label>
  <% end %>
  <label>Summary <%= form.text_field :summary, required: true, placeholder: "Wrote to the recruiter", autocomplete: "off" %></label>
  <%= form.submit "Log it", class: "btn small" %>
<% end %>

<h3>Timeline</h3>
<p class="muted small">Its stages and what happened, dated as you dated them. Every change to it is under History.</p>
<% if @timeline.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>On</th><th>What</th><th>By</th><th>Note</th><th></th></tr></thead>
      <tbody>
        <% @timeline.each do |entry| %>
          <tr>
            <td class="nowrap"><%= entry.on %></td>
            <td class="nowrap">
              <% if entry.stage %>
                <%= entry.from ? "#{Application.stage_label(entry.from)} → " : "Started at " %><%= stage_badge(entry.stage) %>
              <% else %>
                <span class="badge"><%= entry.activity.kind.humanize %></span>
                <% if entry.activity.contact %><span class="muted small">with <%= entry.activity.contact.name %></span><% end %>
              <% end %>
            </td>
            <td><%= actor_label(entry.actor) %></td>
            <td class="reason"><%= entry.note %></td>
            <td class="nowrap">
              <% if (activity = entry.activity) %>
                <details class="row-edit">
                  <summary class="btn small">Edit</summary>
                  <%= form_with url: application_activity_path(@application, activity), method: :patch, class: "add-form" do |form| %>
                    <label>What <%= select_tag :kind, activity_options(activity.kind) %></label>
                    <label>On <%= form.date_field :on, value: activity.occurred_on %></label>
                    <% if company_contacts.any? %>
                      <label>With <%= select_tag :contact_id, options_for_select(company_contacts.map { |contact| [ contact.label, contact.id ] }, activity.contact_id),
                                                  include_blank: "(no one in particular)", id: dom_id(activity, :contact) %></label>
                    <% end %>
                    <label>Summary <%= form.text_field :summary, value: activity.summary, required: true, autocomplete: "off" %></label>
                    <%= form.submit "Save", class: "btn primary small" %>
                  <% end %>
                </details>
                <%= button_to "Delete", application_activity_path(@application, activity), method: :delete, class: "btn small",
                                                                                            data: { turbo_confirm: "Delete this activity from the timeline?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">Nothing yet.</p>
<% end %>

<% end %>

<%= tab_panel "fit" do %>
  <%= render "roles/fit", role: role, fit: @fit, earlier: @earlier_fits, descriptions: @descriptions, run: @fit_run, from: "application" %>
  <h3 id="company-fit">Company fit</h3>
  <% if @company_review %>
    <p class="fit-head"><%= company_fit_cell(@company_review, @profile) %> <span class="muted small">of 100</span> <%= @company_review.why %></p>
    <p class="muted small">
      <%= @application.company.name %> against your company preferences, reviewed <%= ago(@company_review.created_at) %>: a
      separate score, never weighed into the role's fit. <%= link_to "Its full review", company_path(@application.company, anchor: "review") %>
    </p>
  <% else %>
    <p class="muted small">Not reviewed: your own Claude client reviews a company only when you ask.</p>
  <% end %>
<% end %>

<%= tab_panel "writing" do %>
  <%= render "reviews", application: @application, reviews: @reviews, run: @review_run %>
  <%= render "drafts", application: @application, drafts: @drafts, run: @draft_run %>
<% end %>

<%= tab_panel "contacts" do %>
  <%= render "contacts", application: @application, company_contacts: company_contacts %>
<% end %>

<%= tab_panel "notes" do %>
<%= form_with url: note_application_path(@application), method: :patch, class: "add-form" do |form| %>
  <label>Pay expectation <%= form.text_field :comp_expectation, value: @application.comp_expectation, placeholder: "e.g. 25k a month",
                                                                 autocomplete: "off" %></label>
  <label class="wide">Notes <%= form.text_area :notes, value: @application.notes, rows: 4,
                                                       placeholder: "Who you spoke to, what matters to them, what to ask next" %></label>
  <%= form.submit "Save notes", class: "btn small" %>
<% end %>
<% end %>

<%= tab_panel "history" do %>
  <p class="muted small">
    Every change to this application and to what was saved under it (its activities, contacts, drafts and resume reviews):
    who made it, and why. <%= link_to "Narrow it in the audit log", audit_path(record: @application.id) %>
  </p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>When</th><th>Change</th><th>By</th><th>Why</th></tr></thead>
      <tbody>
        <% @history.each do |event| %>
          <tr>
            <td><%= ago(event.occurred_at) %></td>
            <td class="nowrap"><%= change_summary(event) %></td>
            <td><%= actor_cell(event) %></td>
            <td class="reason"><%= event.reasoning %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
</div>
