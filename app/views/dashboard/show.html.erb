<% content_for :title, "Dashboard · Provenance Pipeline" %>
<div class="page-head">
  <div>
    <h1>Dashboard</h1>
    <p class="sub">Where the roles you track stand, and what changed lately.</p>
  </div>
</div>

<h2>Pipeline</h2>
<div class="tiles">
  <% Application::OPEN.each do |stage| %>
    <%= link_to applications_path(anchor: stage), class: [ "tile", ("live" if stage == "offer" && @applications[stage].to_i.positive?) ] do %>
      <div class="value"><%= @applications.fetch(stage, 0) %></div>
      <div class="label"><%= Application.stage_label(stage) %></div>
    <% end %>
  <% end %>
  <%= link_to applications_path(anchor: "closed"), class: "tile" do %>
    <div class="value"><%= Application::CLOSED.sum { |stage| @applications.fetch(stage, 0) } %></div>
    <div class="label">Closed</div>
  <% end %>
</div>
<% if @applications.empty? %>
  <p class="muted small">No application yet: start one from a role's page.</p>
<% end %>

<h2>Tracked roles</h2>
<div class="tiles">
  <% [ [ "verified_live", "live" ], [ "not_found", "gone" ], [ "inaccessible", "unsure" ], [ "pending", "" ] ].each do |state, tone| %>
    <%= link_to roles_path(answer: state), class: [ "tile", tone ] do %>
      <div class="value"><%= @roles.fetch(state, 0) %></div>
      <div class="label"><%= answer_label(state) %></div>
    <% end %>
  <% end %>
  <%= link_to roles_path(tab: "suggested"), class: "tile" do %>
    <div class="value"><%= @tracking.fetch("suggested", 0) %></div>
    <div class="label">Suggested</div>
  <% end %>
  <%= link_to roles_path(tab: "dismissed"), class: "tile" do %>
    <div class="value"><%= @tracking.fetch("dismissed", 0) %></div>
    <div class="label">Dismissed</div>
  <% end %>
  <%= link_to review_path, class: [ "tile", ("unsure" if @review.positive?) ] do %>
    <div class="value"><%= @review %></div>
    <div class="label">To review</div>
  <% end %>
</div>
<% if @stale.positive? %>
  <p class="muted small"><%= pluralize(@stale, "tracked role") %> not checked in the last <%= Overview::STALE_AFTER.inspect %>.</p>
<% end %>

<h2>Check everything</h2>
<%= turbo_frame_tag "check_all", src: check_all_path do %>
  <p class="muted small"><span class="spinner" aria-hidden="true"></span> Working out what a check of everything would read and cost…</p>
<% end %>

<h2>Companies and cost</h2>
<div class="tiles">
  <%= link_to companies_path, class: "tile" do %>
    <div class="value"><%= @companies[:watched] %></div>
    <div class="label">Companies watched</div>
  <% end %>
  <%= link_to companies_path, class: "tile" do %>
    <div class="value"><%= @companies[:boards] %></div>
    <div class="label">Read through a free board</div>
  <% end %>
  <%= link_to companies_path(view: "candidates"), class: "tile" do %>
    <div class="value"><%= @companies[:candidates] %></div>
    <div class="label">Careers pages to confirm</div>
  <% end %>
  <div class="tile">
    <div class="value"><%= money(@spend[:last_30_days]) %></div>
    <div class="label">API credit, last 30 days</div>
  </div>
  <div class="tile">
    <div class="value"><%= money(@spend[:total]) %></div>
    <div class="label">API credit, all time · last call <%= ago(@spend[:last_call]) %></div>
  </div>
</div>

<h2>Recent checks you asked for</h2>
<% if @runs.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Asked</th><th>What</th><th>Answer</th><th class="num">Cost</th></tr></thead>
      <tbody>
        <% @runs.each do |run| %>
          <tr>
            <td><%= ago(run.created_at) %></td>
            <td>
              <% if run.kind == "describe" && run.posting %>
                <%= link_to run.posting.role_title, role_path(run.posting) %> <span class="muted">at <%= run.company.name %> (its description)</span>
              <% elsif run.kind == "role" && run.posting %>
                <%= link_to run.posting.role_title, role_path(run.posting) %> <span class="muted">at <%= run.company.name %></span>
              <% elsif run.kind == "all" %>
                Everything <span class="muted">(<%= run.total ? pluralize(run.total, "company") : "every watched company" %>)</span>
              <% else %>
                <%= link_to run.company.name, company_path(run.company) %> <span class="muted">(its careers page)</span>
              <% end %>
            </td>
            <td>
              <% if run.active? %>
                <span class="badge"><%= run.status == "queued" ? "Waiting" : "Checking…" %></span>
              <% elsif run.status == "failed" %>
                <span class="badge gone">Didn't finish</span> <span class="muted small"><%= run.error.to_s.truncate(90) %></span>
              <% else %>
                <%= run_answer(run) %>
                <% if run.kind != "role" %><span class="muted small"><%= run.summary.to_s.truncate(90) %></span><% end %>
              <% end %>
            </td>
            <td class="num"><%= cost(run.cost_usd) if run.status == "done" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">None yet: "Check now" on a role's or a company's page asks for one.</p>
<% end %>

<h2>Recent verdict changes</h2>
<p class="muted small"><%= link_to "Everything that changed since the last check of everything", changes_path %>: suggestions, careers pages, lists that changed a lot, and more.</p>
<% if @changes.any? %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>When</th><th>Role</th><th>Company</th><th>Change</th><th>By</th><th>Why</th></tr>
      </thead>
      <tbody>
        <% @changes.each do |event| %>
          <% role = event.target %>
          <tr>
            <td><%= ago(event.occurred_at) %></td>
            <td><%= role ? link_to(role.role_title, role_path(role)) : tag.span("deleted role", class: "muted") %></td>
            <td><%= link_to(role.company.name, company_path(role.company)) if role %></td>
            <td class="nowrap"><%= change_summary(event) %></td>
            <td><%= actor_cell(event) %></td>
            <td class="reason"><%= event.reasoning.to_s.truncate(180) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">No verdict has changed yet.</p>
<% end %>
