<% content_for :title, "Dashboard · Provenance Pipeline" %>
<%# Where the search stands, and how it has gone (4e step 12: the dashboard and Analytics, one page): tabs for the
    pipeline, the watch and the agents, each what stands now on top, in tiles, and its history under it, since a day
    when one is set. %>
<% open_now = @pipeline.open.index_by(&:stage) %>
<% fresh = @watch.freshness %>
<div class="page-head">
  <div>
    <h1>Dashboard</h1>
    <p class="sub">Where the search stands now, and how it has gone.</p>
  </div>
</div>

<%= how_this_works do %>
  <p>
    Each tab's tiles say where things stand now. Under them, how it has gone, worked out from the record (the audit log,
    the page reads and the AI calls), since a day if you set one. A rate needs at least <%= Analytics::FLOOR %> to go
    on; below that it says so, rather than reading a trend into a handful.
  </p>
<% end %>

<div data-controller="tabs">
<%= page_tabs([ [ "pipeline", "Pipeline" ], [ "watch", "The watch" ], [ "agents", "Agents" ] ], label: "Dashboard", current: @tab) %>

<%= tab_panel "pipeline", first: @tab == "pipeline" do %>
  <div class="tiles">
    <% Application::OPEN.each do |stage| %>
      <% open = open_now[stage] %>
      <%= link_to applications_path(anchor: stage), class: [ "tile", ("live" if stage == "offer" && @applications[stage].to_i.positive?) ] do %>
        <div class="value"><%= @applications.fetch(stage, 0) %></div>
        <div class="label"><%= Application.stage_label(stage) %></div>
        <% if open %><div class="label">median <%= days_measured(open.median) %> days there, longest <%= days_measured(open.longest) %></div><% end %>
      <% end %>
    <% end %>
    <%= link_to applications_path(anchor: "closed"), class: "tile" do %>
      <div class="value"><%= Application::CLOSED.sum { |stage| @applications.fetch(stage, 0) } %></div>
      <div class="label">Closed</div>
    <% end %>
  </div>
  <p class="muted small">
    <% if @applications.empty? %>No application yet: start one from a role's page. <% end %>
    <%= link_to pluralize(@pipeline.unapplied, "tracked role"), roles_path(answer: "verified_live") %> still listed
    <%= @pipeline.unapplied == 1 ? "has" : "have" %> no application.
  </p>

  <%= render "dashboard/since", tab: "pipeline", note: "Applications started since then." %>
  <%= render "analytics/pipeline" %>
<% end %>

<%= tab_panel "watch", first: @tab == "watch" do %>
  <h3>Tracked roles</h3>
  <div class="tiles">
    <% [ [ "verified_live", "live" ], [ "not_found", "gone" ], [ "inaccessible", "unsure" ], [ "pending", "" ] ].each do |state, tone| %>
      <%= link_to roles_path(answer: state), class: [ "tile", tone ] do %>
        <div class="value"><%= @roles.fetch(state, 0) %></div>
        <div class="label"><%= answer_label(state) %></div>
      <% end %>
    <% end %>
    <%= link_to roles_path(tab: "suggested"), class: "tile" do %>
      <div class="value"><%= @tracking.fetch("suggested", 0) %></div>
      <div class="label">Suggested</div>
    <% end %>
    <%= link_to roles_path(tab: "dismissed"), class: "tile" do %>
      <div class="value"><%= @tracking.fetch("dismissed", 0) %></div>
      <div class="label">Archived</div>
    <% end %>
    <%= link_to review_path, class: [ "tile", ("unsure" if @review.positive?) ] do %>
      <div class="value"><%= @review %></div>
      <div class="label">To review</div>
    <% end %>
  </div>

  <h3>How fresh their answers are</h3>
  <div class="tiles">
    <div class="tile <%= "live" if fresh.tracked.positive? && fresh.fresh == fresh.tracked %>">
      <div class="value"><%= fresh.fresh %></div>
      <div class="label">Of <%= fresh.tracked %> tracked roles, checked in the last <%= Overview::STALE_AFTER.inspect %></div>
    </div>
    <div class="tile <%= "unsure" if fresh.stale.positive? %>">
      <div class="value"><%= fresh.stale %></div>
      <div class="label">Checked longer ago<%= " (the oldest #{pluralize(fresh.oldest, 'day')})" if fresh.stale.positive? %></div>
    </div>
    <div class="tile">
      <div class="value"><%= fresh.never %></div>
      <div class="label">Never checked</div>
    </div>
  </div>

  <h3>Companies</h3>
  <div class="tiles">
    <%= link_to companies_path, class: "tile" do %>
      <div class="value"><%= @companies[:watched] %></div>
      <div class="label">Companies watched</div>
    <% end %>
    <%= link_to companies_path, class: "tile" do %>
      <div class="value"><%= @companies[:boards] %></div>
      <div class="label">Read through a free board</div>
    <% end %>
    <%= link_to companies_path(filter: "to_confirm"), class: "tile" do %>
      <div class="value"><%= @companies[:candidates] %></div>
      <div class="label">Careers pages to confirm</div>
    <% end %>
    <%= link_to companies_path(tab: "suggested"), class: "tile" do %>
      <div class="value"><%= @companies[:proposed] %></div>
      <div class="label">Companies proposed to you</div>
    <% end %>
  </div>
  <p class="small">
    <% if @list_ages.companies.zero? %>
      No company is tracked with a careers page to read yet.
    <% else %>
      Of <%= pluralize(@list_ages.companies, "tracked company") %>, <%= @list_ages.stale %> lists last read more than
      <%= Overview::STALE_AFTER.inspect %> ago<%= ", the oldest " if @list_ages.oldest %><%= ago(@list_ages.oldest) if @list_ages.oldest %>, and
      <%= @list_ages.never %> never.
    <% end %>
    Your AI assistant's role search reads these lists as they were last read: <%= link_to "Check all tracked companies", roles_path %>,
    on the Roles page, reads them again. What a check found: <%= link_to "the audit log's Check results", audit_path(view: "checks") %>.
  </p>

  <%= render "dashboard/since", tab: "watch", note: "Roles first seen listed, and the reads made, since then." %>
  <%= render "analytics/watch" %>
<% end %>

<%= tab_panel "agents", first: @tab == "agents" do %>
  <div class="tiles">
    <div class="tile">
      <div class="value"><%= money(@spend[:last_30_days]) %></div>
      <div class="label">API credit, last 30 days</div>
    </div>
    <div class="tile">
      <div class="value"><%= money(@spend[:total]) %></div>
      <div class="label">API credit, all time · last call <%= ago(@spend[:last_call]) %></div>
    </div>
  </div>

  <%= render "dashboard/runs", runs: @runs %>

  <%= render "dashboard/since", tab: "agents", note: "The calls, reads, recommendations and writes made since then." %>
  <%= render "analytics/agents" %>
<% end %>
</div>
