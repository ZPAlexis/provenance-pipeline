<%# "Check now" for a role or a company, with what it could cost, and its latest run. Compact (4e), in a page's header:
    the button alone, what it reads and costs on hover, and the page shows the run itself. %>
<% why_not = Verifier::CheckNow.refusal(record) %>
<% role = record.is_a?(Posting) %>
<% compact = local_assigns[:compact] %>
<% if compact %>
  <% if why_not %>
    <span class="muted small"><%= why_not %></span>
  <% elsif !run&.active? %>
    <% ceiling = Verifier::CheckNow.ceiling(record) %>
    <% about = render("check_runs/about", record: record, role: role, ceiling: ceiling) %>
    <%= form_with url: check_runs_path, class: "check-form", data: { turbo_confirm: ("This check may read the careers page with the LLM: #{check_cost(ceiling, record)}. Check now?" if ceiling.positive?) } do |form| %>
      <%= hidden_field_tag(role ? :posting_id : :company_id, record.id) %>
      <%= form.submit "Check now", class: "btn", title: strip_tags(about).squish %>
    <% end %>
  <% end %>
<% else %>
<section class="check-now">
  <% if why_not %>
    <p class="muted small"><%= why_not %></p>
  <% elsif !run&.active? %>
    <% ceiling = Verifier::CheckNow.ceiling(record) %>
    <% confirm = ("This check may read the careers page with the LLM: #{check_cost(ceiling, record)}. Check now?" if ceiling.positive?) %>
    <%= form_with url: check_runs_path, class: "check-form", data: { turbo_confirm: confirm } do |form| %>
      <%= hidden_field_tag(role ? :posting_id : :company_id, record.id) %>
      <%= form.submit "Check now", class: "btn primary" %>
      <span class="muted small"><%= render "check_runs/about", record: record, role: role, ceiling: ceiling %></span>
    <% end %>
  <% end %>
  <%= render "check_runs/run", run: run, poll: false if run %>
</section>
<% end %>
