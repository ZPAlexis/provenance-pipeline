<%# "Check all tracked companies", on the Roles page (4e): the run under way, or the plan, its ceiling, how old the lists
    are, and the button. Since 4f, a free check beside it: no AI, the pages that need reading left for your AI assistant
    (the only way when no API key is set), and the pages a check left unread. %>
<%= turbo_frame_tag "check_all" do %>
  <section class="check-now check-all">
    <% if @run&.active? %>
      <%= render "check_runs/run", run: @run, poll: false %>
    <% elsif @plan.companies.zero? %>
      <p class="muted small">No company is tracked with a careers page to read yet: add one, or track one.</p>
    <% else %>
      <% free_only = Verifier::CheckNow.free_only? %>
      <% unless free_only %>
        <% confirm = "Check all tracked companies: the careers pages of #{pluralize(@plan.companies, 'company')}, for the " \
                     "#{pluralize(@plan.roles, 'role')} you track and new roles that fit your profile, " \
                     "#{check_cost(@plan.ceiling, known: @plan.known_cost?)}. Go?" %>
        <%= form_with url: check_all_path, class: "check-form", data: { turbo_frame: "_top", turbo_confirm: confirm } do |form| %>
          <%= form.submit "Check all tracked companies", class: "btn" %>
          <span class="muted small">
            Reads the careers pages of <%= pluralize(@plan.companies, "company") %><%= " (#{@plan.without_roles} with no role of yours yet)" if @plan.without_roles.positive? %>:
            confirms the <%= pluralize(@plan.roles, "role") %> you track, and finds new ones that fit your profile.
            <%= @plan.via_board %> through free boards, <%= @plan.reusable %> with earlier reads reused where their roles are unchanged;
            <%= check_cost(@plan.ceiling, known: @plan.known_cost?) %><%= " (#{pluralize(@plan.unread, 'page')} never read, priced at an average list: a long list costs more)" if @plan.unread.positive? %>.
          </span>
        <% end %>
      <% end %>
      <% free_confirm = "A free check of all tracked companies: no AI. Up to #{pluralize(@plan.to_read, 'company')}' pages " \
                        "may be left unread, for your AI assistant to read. Go?" %>
      <%= form_with url: check_all_path, class: "check-form", data: { turbo_frame: "_top", turbo_confirm: free_confirm } do |form| %>
        <%= hidden_field_tag :mode, "free" %>
        <%= form.submit free_only ? "Check all tracked companies" : "Check free", class: "btn" %>
        <span class="muted small">
          <% if free_only %>
            Free: no API key is set, so no AI reads a page. Free boards, and pages whose roles are unchanged, are read as
            ever; up to <%= pluralize(@plan.to_read, "company") %>' pages may be left for your AI assistant to read.
          <% else %>
            The same, with no AI: free boards and unchanged pages are read as ever, and up to
            <%= pluralize(@plan.to_read, "company") %>' pages that need reading are left for your AI assistant.
          <% end %>
        </span>
      <% end %>
      <% if @ages.stale.positive? || @ages.never.positive? %>
        <p class="muted small">
          Lists last read: <%= @ages.stale %> more than <%= Overview::STALE_AFTER.inspect %> ago<%= ", the oldest " if @ages.oldest %><%= ago(@ages.oldest) if @ages.oldest %>; <%= @ages.never %> never.
        </p>
      <% end %>
      <%= render "check_runs/run", run: @run, poll: false if @run %>
    <% end %>
    <% if @to_read.any? %>
      <details class="to-read">
        <summary class="small">
          <%= pluralize(@to_read.size, "page") %> left unread by a free check: <%= @to_read.size == 1 ? "it needs" : "they need" %>
          reading, by your AI assistant or a check with the app's AI
        </summary>
        <ul class="small">
          <% @to_read.each do |page| %>
            <li>
              <%= link_to page.company.name, company_path(page.company), data: { turbo_frame: "_top" } %> ·
              <%= compact_link(page.url) %> · <span class="muted">left <%= ago(page.since) %></span>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </section>
<% end %>
