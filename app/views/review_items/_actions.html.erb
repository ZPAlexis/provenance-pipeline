<%# The operator's choices on one item, by its kind; the proposed action first. %>
<% url = decide_review_item_path(item) %>
<% role = item.subject if item.subject.is_a?(Posting) %>
<div class="decide">
  <% case item.kind %>
  <% when "careers_page_candidate" %>
    <%= outside_link(item.evidence_key, label: "Open the page") %>
    <%= button_to "Confirm it", url, method: :patch, params: { decision: "confirm" }, class: "btn primary small" %>
    <%= button_to "Reject it", url, method: :patch, params: { decision: "reject" }, class: "btn small" %>
  <% when "company_kind" %>
    <% Company::KINDS.each do |kind| %>
      <%= button_to kind.capitalize, url, method: :patch, params: { decision: "set_kind", kind: kind },
                                         class: [ "btn", "small", ("primary" if item.proposal == "set_kind:#{kind}") ] %>
    <% end %>
  <% when "no_careers_page" %>
    <%= button_to "Find it again", url, method: :patch, params: { decision: "find_again" },
                                        class: [ "btn", "small", "check-button", ("primary" if item.proposal == "find_again") ],
                                        data: { turbo_confirm: "Finding its careers page and reading it: at most #{cost(Verifier::CheckNow.ceiling(item.company))}. Go?" } %>
  <% when "suspect_verdict", "unconfirmed_role" %>
    <% if role %>
      <%= outside_link(role.job_url, label: "Open its page") if role.job_url %>
      <%= button_to "Check it again", url, method: :patch, params: { decision: "check_again" },
                                           class: [ "btn", "small", "check-button", ("primary" if item.proposal == "check_again") ],
                                           data: { turbo_confirm: "Checking it now: its own page first; at most #{cost(Verifier::CheckNow.ceiling(role))}. Go?" } %>
    <% end %>
  <% end %>
</div>

<% if role && %w[suspect_verdict unconfirmed_role].include?(item.kind) %>
  <%= form_with url: url, method: :patch, class: "add-form" do |form| %>
    <label>What you saw <%= form.text_field :note, required: true, placeholder: "Its page lists it, posted last week" %></label>
    <%= form.button "Still listed", name: "decision", value: "still_listed", class: "btn small primary" %>
    <%= form.button "No longer listed", name: "decision", value: "no_longer_listed", class: "btn small" %>
    <% if item.kind == "suspect_verdict" %>
      <%= form.button "Undo the verdict", name: "decision", value: "undo", class: "btn small",
                                          title: "Restores what the verifier's latest verdict replaced; your note is why." %>
    <% end %>
  <% end %>
<% end %>

<% if %w[careers_page_candidate no_careers_page partial_list].include?(item.kind) %>
  <details class="add" <%= "open" if item.proposal == "set_page" %>>
    <summary class="muted small"><%= item.kind == "partial_list" ? "Set a page listing them all" : "Set its careers page by hand" %></summary>
    <%= form_with url: url, method: :patch, class: "add-form" do |form| %>
      <%= hidden_field_tag :decision, "set_page" %>
      <label>Careers page <%= form.url_field :url, required: true, placeholder: "https://acme.com/careers" %></label>
      <label>How you know <%= form.text_field :note, required: true, placeholder: "Linked from its homepage" %></label>
      <%= form.submit "Set it", class: "btn small" %>
    <% end %>
  </details>
<% end %>

<details class="add">
  <summary class="muted small">Leave it as is</summary>
  <%= form_with url: url, method: :patch, class: "add-form" do |form| %>
    <%= hidden_field_tag :decision, "leave" %>
    <label>Why <%= form.text_field :note, required: true, placeholder: "No public list of roles" %></label>
    <%= form.submit "Leave it", class: "btn small" %>
  <% end %>
</details>
