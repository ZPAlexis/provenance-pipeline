<% content_for :title, "Review · Provenance Pipeline" %>
<%# A decision redirects back here: keep the operator's place in the list, and the notice in view. %>
<% turbo_refreshes_with method: :replace, scroll: :preserve %>
<% content_for :floating_flash, true %>
<div class="page-head">
  <div>
    <h1>To review</h1>
    <p class="sub">
      What an agent saw that needs your judgment, each with what was seen and a proposed action. Raised by the agent
      that saw it; closed by your decision, or when the record resolves it.
    </p>
    <% if @agreement.any? %>
      <p class="muted small">
        Recommendations so far:
        <%= safe_join(@agreement.sort.map { |kind, tally| "#{review_kind_label(kind)}: #{ReviewRecommendations.summary(tally)}" }, "; ") %>.
      </p>
    <% end %>
  </div>
</div>

<% if @recommended_total.positive? && !@recommended %>
  <p class="recommended-callout">
    <%= pluralize(@recommended_total, "item") %> <%= @recommended_total == 1 ? "carries" : "carry" %> a recommendation from your
    Claude client, ready to accept or decide.
    <%= link_to "See them", review_path(recommended: 1), class: "btn small primary" %>
  </p>
<% end %>

<nav class="tabs">
  <%= link_to review_path, class: ("current" unless @kind) do %>
    All <span class="count"><%= @counts.values.sum %></span>
  <% end %>
  <% ReviewItem::KINDS.each do |kind| %>
    <%= link_to review_path(kind: kind), class: ("current" if kind == @kind) do %>
      <%= review_kind_label(kind) %> <span class="count"><%= @counts.fetch(kind, 0) %></span>
    <% end %>
  <% end %>
</nav>

<% if @recommended_count.positive? || @recommended %>
  <nav class="filters" aria-label="Filter by recommendation">
    <%= link_to review_path(kind: @kind), class: [ "filter", ("current" unless @recommended) ] do %>
      All<% end %>
    <%= link_to review_path(kind: @kind, recommended: 1), class: [ "filter", ("current" if @recommended) ] do %>
      With a recommendation <span class="count"><%= @recommended_count %></span>
    <% end %>
  </nav>
<% end %>

<% if @items.any? %>
  <ol class="review-list">
    <% @items.each do |item| %>
      <li class="review-item" id="<%= dom_id(item) %>">
        <div class="review-head">
          <span class="badge"><%= review_kind_label(item.kind) %></span>
          <%= review_subject_links(item) %>
        </div>
        <p class="review-question"><strong><%= review_question(item) %></strong></p>
        <p class="small"><%= item.evidence %></p>
        <p class="small">
          <span class="muted">Proposed:</span> <%= review_proposal(item) %>
          · <span class="muted">Raised by <%= actor_label(item.raised_by) %> <%= ago(item.created_at) %></span>
        </p>
        <%= render "recommendation", item: item if item.recommended? %>
        <% if (run = @runs[item.id]) %>
          <%= render "check_runs/run", run: run, poll: false, item: item %>
        <% end %>
        <div class="review-actions">
          <details class="guidance">
            <summary class="muted small">What to check</summary>
            <p class="small"><%= review_guidance(item) %></p>
          </details>
          <%= render "actions", item: item %>
        </div>
      </li>
    <% end %>
  </ol>
<% else %>
  <p class="empty">Nothing to review<%= " of this kind" if @kind %><%= " with a recommendation" if @recommended %>.</p>
<% end %>
