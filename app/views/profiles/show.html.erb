<% content_for :title, "Profile · Provenance Pipeline" %>
<div class="page-head">
  <div>
    <h1>Search profile</h1>
    <p class="sub">
      What you are looking for. Roles on watched pages that fit it will be suggested; only you decide which to track.
      <% if @profile.persisted? %>Saved <%= ago(@profile.updated_at) %>.<% end %>
    </p>
  </div>
</div>

<%= form_with model: @profile, url: profile_path, method: :patch, class: "profile-form" do |f| %>
  <%= render "errors", profile: @profile %>

  <div class="field">
    <%= f.label :titles_text, "Titles" %>
    <p class="hint">
      One per line. A role fits when its title holds every word of one, in any order:
      "Solutions Engineer" fits "Senior Engineer, Solutions". A single word fits any title holding it.
    </p>
    <%= f.text_area :titles_text, rows: 6, placeholder: "Product Designer\nData Analyst\nAnalytics" %>
    <div class="related-ask">
      <%= f.button "Suggest related titles", type: "submit", formaction: related_profile_path, class: "btn small",
                                             data: { turbo_frame: "related-titles", turbo_submits_with: "Asking…",
                                                     turbo_confirm: "One AI call proposes titles in the same area as yours, " \
                                                                    "in the languages of your places: about #{cost(Verifier::RelatedTitles.estimate)}. Ask?" } %>
      <span class="hint">Titles employers use for the same work, each with how many new roles it would add. You pick.</span>
    </div>
    <%= turbo_frame_tag "related-titles" %>
  </div>

  <div class="field">
    <%= f.label :excluded_words_text, "Excluded words" %>
    <p class="hint">One per line. A title holding every word of one is ruled out.</p>
    <%= f.text_area :excluded_words_text, rows: 3, placeholder: "Intern\nVice President" %>
  </div>

  <div class="field">
    <%= f.label :places_text, "Places" %>
    <p class="hint">
      Where you can work, one per line. A country takes roles in it by any of its names, codes, cities, or states
      (Brazil: Brasil, BRA, São Paulo, Minas Gerais), and remote roles open to a region containing it (Latin America,
      Americas) or to anywhere. A region takes roles open to it, not every role inside it. A location naming no place
      ("Remote" alone) fits, marked. A place the app does not know is matched by its words.
    </p>
    <%= f.text_area :places_text, rows: 4, placeholder: "Brazil" %>
  </div>

  <fieldset class="field">
    <legend>Work modes</legend>
    <div class="choices">
      <%= f.collection_check_boxes :work_modes, work_mode_options, :first, :last do |box| %>
        <%= box.label { box.check_box + " " + box.text } %>
      <% end %>
    </div>
    <p class="hint">None ticked: any. A role whose page does not state its mode fits, marked.</p>
  </fieldset>

  <fieldset class="field">
    <legend>Levels</legend>
    <div class="choices">
      <%= f.collection_check_boxes :levels, level_options, :first, :last do |box| %>
        <%= box.label { box.check_box + " " + box.text } %>
      <% end %>
    </div>
    <p class="hint">As the title states it. None ticked: any. A title stating no level ("Product Designer") fits, marked.</p>
  </fieldset>

  <div class="actions">
    <%= f.button "Preview", type: "submit", formaction: preview_profile_path, class: "btn",
                            data: { turbo_frame: "profile-preview", turbo_submits_with: "Weighing roles…" } %>
    <%= f.button "Save", type: "submit", class: "btn primary" %>
  </div>
<% end %>

<h2 id="resume">Resume</h2>
<p class="muted small">
  Paste your resume as plain text or Markdown and save it: the drafter reads it, with each role's description, and claims only what it shows.
  Each time you save a changed text, the one before is kept as an earlier version below. It is held in this database only:
  never in the repository, its fixtures, or its seeds. The record of each save names its size and a hash, never its text.
</p>
<% if @profile.persisted? %>
  <% current, *earlier = @resumes %>
  <% if current %>
    <p class="small">Saved <%= ago(current.created_at) %>: <%= number_with_delimiter(current.words) %> words.</p>
  <% end %>
  <%= form_with url: resume_profile_path, method: :patch, id: "resume-form", class: "add-form" do |form| %>
    <label class="wide">Your resume <%= form.text_area :resume_text, value: current&.text, rows: 12, required: true,
                                                                     placeholder: "Paste your resume here, as text" %></label>
  <% end %>
  <div class="button-row">
    <button type="submit" form="resume-form" class="btn primary small"><%= current ? "Save changes" : "Save resume" %></button>
    <% if current %>
      <%= button_to "Delete resume", resume_profile_path, method: :delete, class: "btn small",
                                     data: { turbo_confirm: "Delete your resume, and every earlier version of it? This can't be undone." } %>
    <% end %>
  </div>
  <% if earlier.any? %>
    <details class="description">
      <summary class="muted small"><%= pluralize(earlier.size, "earlier version") %></summary>
      <% earlier.each do |version| %>
        <p class="muted small">Saved <%= version.created_at.to_date %> (<%= number_with_delimiter(version.words) %> words)</p>
        <div class="description-text"><%= version.text %></div>
      <% end %>
    </details>
  <% end %>
<% else %>
  <p class="muted small">Save the profile above first: the resume is kept with it.</p>
<% end %>

<%= turbo_frame_tag "profile-preview" do %>
  <p class="muted">
    Preview weighs the profile above, saved or not, against every watched company's roles as its page last listed them.
    It costs nothing and writes nothing.
  </p>
<% end %>

<h2 id="company">What you want of a company</h2>
<p class="muted small">
  Your own Claude client weighs a company against these when you ask it to review one, and proposes companies that may
  fit them; where a company hires is weighed against your places above. A review read against them before is marked
  stale when you change them. What you want and avoid, and the words to avoid, are your own business: the record of
  each save holds them by a hash, never their text.
</p>
<% if @profile.persisted? %>
  <%= form_with model: @profile, scope: :company_preferences, url: company_preferences_profile_path, method: :patch, class: "profile-form" do |f| %>
    <div class="field">
      <%= f.label :company_wants, "What you want" %>
      <p class="hint">In your own words: what it makes and for whom, how it works, what matters to you in a company.</p>
      <%= f.text_area :company_wants, rows: 3, placeholder: "Software for sales and revenue teams; a product people use daily" %>
    </div>

    <div class="field">
      <%= f.label :company_avoids, "What you avoid" %>
      <p class="hint">A company that does any of it scores at most 49, however much else it meets.</p>
      <%= f.text_area :company_avoids, rows: 3, placeholder: "Ad tech built on tracking people" %>
    </div>

    <fieldset class="field">
      <legend>Stages</legend>
      <div class="choices">
        <%= f.collection_check_boxes :company_stages, company_stage_options, :first, :last do |box| %>
          <%= box.label { box.check_box + " " + box.text } %>
        <% end %>
      </div>
      <p class="hint">None ticked: any.</p>
    </fieldset>

    <fieldset class="field">
      <legend>Sizes</legend>
      <div class="choices">
        <%= f.collection_check_boxes :company_sizes, company_size_options, :first, :last do |box| %>
          <%= box.label { box.check_box + " " + box.text } %>
        <% end %>
      </div>
      <p class="hint">None ticked: any.</p>
    </fieldset>

    <fieldset class="field">
      <legend>Business models</legend>
      <div class="choices">
        <%= f.collection_check_boxes :company_models, company_model_options, :first, :last do |box| %>
          <%= box.label { box.check_box + " " + box.text } %>
        <% end %>
      </div>
      <p class="hint">None ticked: any.</p>
    </fieldset>

    <div class="field">
      <%= f.label :company_industries, "Industries" %>
      <p class="hint">One per line, in your own words. A review names a company's industries in these words where they fit, so the Companies page can filter on them.</p>
      <%= f.text_area :company_industries, value: @profile.company_industries_text, rows: 3, placeholder: "Fintech\nDeveloper tools" %>
    </div>

    <div class="field">
      <%= f.label :company_excluded, "Words to avoid" %>
      <p class="hint">One per line: an industry or a kind of product you won't work for. A company found doing one scores at most 49.</p>
      <%= f.text_area :company_excluded, value: @profile.company_excluded_text, rows: 3, placeholder: "Gambling" %>
    </div>

    <div class="actions">
      <%= f.button "Save company preferences", type: "submit", class: "btn primary" %>
    </div>
  <% end %>
  <% if @profile.company_preferences? %>
    <% due = CompanyReviews.due(profile: @profile).count %>
    <p class="muted small">
      Version <code><%= @profile.company_preferences_version %></code>, what a review is read against:
      <%= pluralize(due, "company") %> tracked or proposed <%= due == 1 ? "has" : "have" %> no review against them as they are now
      (on the Companies page: Not reviewed, or Stale).
    </p>
  <% end %>
<% else %>
  <p class="muted small">Save the profile above first: the company preferences are kept with it.</p>
<% end %>
