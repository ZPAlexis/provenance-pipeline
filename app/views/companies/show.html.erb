<% content_for :title, "#{@company.name} · Provenance Pipeline" %>
<div class="page-head">
  <div>
    <h1><%= @company.name %></h1>
    <p class="sub"><%= domain_link(@company) %></p>
  </div>
  <div><%= tracking_badge(@company.tracking) %></div>
</div>
<%= render "companies/watch", company: @company, in_play: @in_play, open_application: @open_application, archived_with: @archived_with %>
<% if @company.dismissed? %>
  <p class="muted small">Archived: never checked, suggested from or reviewed, until you track it again.</p>
<% elsif @company.suggested? %>
  <p class="muted small">Proposed by your own Claude client: not watched, checked or reviewed until you track it. Tracking it reads the board it was proposed with at once, free; archiving it declines it for good.</p>
<% end %>

<dl class="facts">
  <dt>Careers page</dt>
  <dd><%= careers_page_cell(@company) %></dd>
  <dt>Read through</dt>
  <dd><%= read_through(@company) %></dd>
</dl>

<details class="facts-more">
  <summary class="muted small">How its careers page was found, and what kind of company it is</summary>
  <dl class="facts">
    <dt>How it was found</dt>
    <dd>
      <%= @company.resolution_status || "not attempted" %><%= [ @company.resolution_method, @company.resolution_confidence ].compact.map { |v| ", #{v}" }.join %><%= ", #{@company.resolution_failure}" if @company.resolution_failure %>
    </dd>
    <% if @company.resolution_candidate_url %>
      <dt>Candidate to confirm</dt>
      <dd><%= outside_link(@company.resolution_candidate_url, label: @company.resolution_candidate_url) %></dd>
    <% end %>
    <dt>Kind</dt>
    <dd><%= @company.kind || tag.span("not set", class: "muted") %><%= " (suggested: #{@company.kind_suggestion})" if @company.kind_suggestion %></dd>
    <% if @company.board_vendor %>
      <dt>Free board</dt>
      <dd>
        <%= outside_link(Verifier::Resolution.board_url(@company.board_vendor, @company.board_token), label: "#{@company.board_vendor}/#{@company.board_token}") %>,
        confirmed <%= ago(@company.board_confirmed_at) %>:
        <%= @company.board_in_use ? "read in place of the page" : "the page is read again" %>
        <div class="muted small"><%= @company.board_evidence %></div>
      </dd>
    <% end %>
  </dl>
</details>

<% if @company.resolution_status == "candidate" %>
  <h2>Is this its careers page?</h2>
  <p class="muted small">
    Found at low confidence (<%= @company.resolution_method %>): never watched until you say so.
    <%= "Its pages list many employers' roles: it may be a #{@company.kind_suggestion}. #{@company.kind_evidence}" if @company.kind_suggestion %>
  </p>
  <div class="decide">
    <%= button_to "Confirm it", confirm_page_company_path(@company), method: :patch, class: "btn primary" %>
    <%= button_to "Reject it", reject_page_company_path(@company), method: :patch, class: "btn" %>
  </div>
<% end %>

<h2>Check its careers page now</h2>
<%= render "check_runs/panel", record: @company, run: @run %>

<details class="add">
  <summary class="muted small">Rename it</summary>
  <%= form_with url: rename_company_path(@company), method: :patch, class: "add-form" do |form| %>
    <label>Name <%= form.text_field :name, value: @company.name, required: true %></label>
    <%= form.submit "Rename", class: "btn" %>
  <% end %>
</details>

<details class="add" <%= "open" if @company.resolution_status.in?([ nil, "failed" ]) %>>
  <summary class="muted small">Set its careers page by hand</summary>
  <%= form_with url: set_page_company_path(@company), method: :patch, class: "add-form" do |form| %>
    <label>Careers page <%= form.url_field :url, required: true, placeholder: "https://acme.com/careers" %></label>
    <label>How you know <%= form.text_field :note, required: true, placeholder: "Linked from its homepage" %></label>
    <%= form.submit "Set as its careers page", class: "btn" %>
  <% end %>
</details>

<h2>Roles</h2>
<% if @company.dismissed? %>
  <p class="muted small">Track it again to add a role here.</p>
<% else %>
  <details class="add" <%= "open" if params[:add_role] %>>
    <summary class="btn small">Add a role here</summary>
    <%= render "roles/add_form", company: @company %>
  </details>
<% end %>
<% if @roles.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Role</th><th>Location</th><th>Answer</th><th>Watch list</th><th>Checked</th><th>Own page</th></tr></thead>
      <tbody>
        <% @roles.each do |role| %>
          <tr>
            <td><%= link_to role.role_title, role_path(role) %></td>
            <td class="muted"><%= role.location %></td>
            <td><%= answer_badge(role.verification_state) %></td>
            <td><%= tracking_badge(role.tracking) %></td>
            <td><%= ago(role.last_checked_at) %></td>
            <td><%= outside_link(role.job_url) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">No role on record here yet.</p>
<% end %>

<%= render "contacts", company: @company, contacts: @contacts %>

<h2>Recent checks</h2>
<% if @checks.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>When</th><th>Why</th><th>Page</th><th>Read</th><th>Outcome</th><th class="num">Roles</th></tr></thead>
      <tbody>
        <% @checks.each do |check| %>
          <% flags = { "part of the list" => check.listings_incomplete, "one job's ad" => check.single_job_posting,
                       "many employers" => check.many_employers }.select { |_, on| on }.keys %>
          <tr>
            <td><%= ago(check.checked_at) %></td>
            <td class="muted"><%= [ check.purpose, check.step ].compact.join(" · ") %></td>
            <td><%= outside_link(check.url) %></td>
            <td class="muted"><%= read_via_label(check.read_via) %></td>
            <td><%= check.outcome %><%= " (#{check.reason})" if check.reason %><%= tag.div(flags.join(", "), class: "muted small") if flags.any? %></td>
            <td class="num"><%= check.listing_count %><%= " of #{check.stated_total}" if check.stated_total %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">Never checked.</p>
<% end %>

<h2>Recent changes</h2>
<% if @events.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>When</th><th>By</th><th>Changed</th><th>Why</th></tr></thead>
      <tbody>
        <% @events.each do |event| %>
          <tr>
            <td><%= ago(event.occurred_at) %></td>
            <td><%= actor_cell(event) %></td>
            <td class="muted"><%= event.changes_made.keys.join(", ") %></td>
            <td class="reason"><%= event.reasoning.to_s.truncate(240) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="muted small"><%= link_to "Every change to this company, in the audit log", audit_path(record: @company.id) %></p>
<% else %>
  <p class="empty">No changes recorded.</p>
<% end %>
