<% content_for :title, "Companies · Provenance Pipeline" %>
<div class="page-head">
  <div>
    <h1>Companies</h1>
    <p class="sub">The companies watched, and how each one's careers page is read.</p>
  </div>
</div>

<details class="add" <%= "open" if flash[:alert] %>>
  <summary class="btn">Add a company</summary>
  <% ceiling = Verifier::CheckNow.ceiling(Company.new) %>
  <%= form_with url: companies_path, class: "add-form",
                data: { turbo_confirm: "Adding it reads its careers page right away: at most #{cost(ceiling)}, free on an ATS board. Add it?" } do |form| %>
    <label>
      Its domain, careers page, or ATS board
      <%= form.text_field :link, required: true, placeholder: "acme.com, acme.com/careers, or jobs.lever.co/acme" %>
    </label>
    <label>
      <span>Name <span class="muted">(optional)</span></span>
      <%= form.text_field :name, placeholder: "Acme" %>
    </label>
    <%= form.submit "Add and read", class: "btn primary" %>
    <p class="muted small">
      Its careers page is found first: the link you give is tried first, and a page found only at low confidence
      waits for you to confirm. A job board's link (LinkedIn, Indeed) is never read: give the employer's own.
    </p>
  <% end %>
</details>

<nav class="tabs">
  <% { "watched" => "Watched", "candidates" => "To confirm", "unresolved" => "No page yet", "all" => "All" }.each do |view, label| %>
    <%= link_to companies_path(view: view), class: ("current" if view == @view) do %>
      <%= label %> <span class="count"><%= @counts.fetch(view) %></span>
    <% end %>
  <% end %>
</nav>

<% if @companies.empty? %>
  <p class="empty">None.</p>
<% else %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Company</th><th>Careers page</th><th>Read through</th><th>Kind</th><th class="num">Still listed</th><th class="num">Roles</th><th>Last checked</th></tr>
      </thead>
      <tbody>
        <% @companies.each do |company| %>
          <% live = @roles.fetch([ company.id, "verified_live" ], 0) %>
          <% total = @roles.sum { |(id, _), count| id == company.id ? count : 0 } %>
          <tr>
            <td><%= link_to company.name, company_path(company) %></td>
            <td><%= outside_link(company.careers_page_url || company.resolution_candidate_url) %></td>
            <td class="muted"><%= read_through(company) %></td>
            <td class="muted"><%= company.kind || "—" %></td>
            <td class="num"><%= live %></td>
            <td class="num"><%= total %></td>
            <td><%= ago(@last_checked[company.id]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
