<% content_for :title, "Companies · Provenance Pipeline" %>
<div class="page-head">
  <div>
    <h1>Companies</h1>
    <p class="sub">
      The companies you track: each one's careers page is watched for roles. Archive one you no longer want, with its
      roles: it is never checked, suggested from or reviewed again, until you track it.
    </p>
  </div>
</div>

<details class="add" <%= "open" if flash[:alert] %>>
  <summary class="btn">Add a company</summary>
  <% ceiling = Verifier::CheckNow.ceiling(Company.new) %>
  <%= form_with url: companies_path, class: "add-form",
                data: { turbo_confirm: "Adding it reads its careers page right away: at most #{cost(ceiling)}, free on an ATS board. Add it?" } do |form| %>
    <label>
      Its domain, careers page, or ATS board
      <%= form.text_field :link, required: true, placeholder: "acme.com, acme.com/careers, or jobs.lever.co/acme" %>
    </label>
    <label>
      <span>Name <span class="muted">(optional)</span></span>
      <%= form.text_field :name, placeholder: "Acme" %>
    </label>
    <%= form.submit "Add and read", class: "btn primary" %>
    <p class="muted small">
      Its careers page is found first: the link you give is tried first, and a page found only at low confidence
      waits for you to confirm. A job board's link (LinkedIn, Indeed) is never read: give the employer's own.
    </p>
  <% end %>
</details>

<nav class="tabs">
  <% CompaniesController::TABS.each do |tab, label| %>
    <%= link_to companies_path(tab: tab, q: @q), class: ("current" if tab == @tab) do %>
      <%= label %> <span class="count"><%= @counts.fetch(tab) %></span>
    <% end %>
  <% end %>
</nav>

<%= render "shared/find", url: companies_path, keep: { tab: @tab, filter: @filter }, value: @q,
                          clear: companies_path(tab: @tab, filter: @filter), placeholder: "Name, domain, or a place it hires in" %>

<nav class="filters" aria-label="What needs a look">
  <%= link_to companies_path(tab: @tab, q: @q), class: [ "filter", ("current" if @filter.nil?) ] do %>
    All <span class="count"><%= @counts.fetch(@tab) %></span>
  <% end %>
  <% CompaniesController::FILTERS.each do |filter, (label, holds, _)| %>
    <%= link_to companies_path(tab: @tab, filter: filter, q: @q), class: [ "filter", ("current" if filter == @filter) ], title: holds do %>
      <%= label %> <span class="count"><%= @filter_counts.fetch(filter) %></span>
    <% end %>
  <% end %>
</nav>

<% if @companies.empty? %>
  <p class="empty"><%= @q ? "No company here matches “#{@q}”." : "None." %></p>
<% else %>
  <% bulk = @tab == "tracked" %>
  <%= tag.div(data: { controller: ("bulk" if bulk) }) do %>
    <% if bulk %>
      <%= form_with url: dismiss_many_companies_path, method: :patch, id: "bulk-archive", class: "bulk-form",
                    data: { turbo_confirm: "Archive the selected companies, with their tracked and suggested roles? They are never " \
                                           "checked, suggested from or reviewed again, until you track one by hand." } do |form| %>
        <span class="muted small" data-bulk-target="count">None selected</span>
        <%= form.text_field :note, required: true, autocomplete: "off", "aria-label": "Why archive them",
                                   placeholder: "Why archive them?" %>
        <%= form.submit "Archive selected", class: "btn small", disabled: true, data: { bulk_target: "submit" } %>
      <% end %>
    <% end %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <% if bulk %>
              <th><input type="checkbox" aria-label="Select every company listed" data-bulk-target="all" data-action="bulk#all"></th>
            <% end %>
            <th>Company</th><th>Careers page</th><th>Roles</th><th>Application</th><th>Last checked</th>
          </tr>
        </thead>
        <tbody>
          <% @companies.each do |company| %>
            <tr>
              <% if bulk %>
                <td><input type="checkbox" name="ids[]" value="<%= company.id %>" form="bulk-archive" aria-label="Select <%= company.name %>"
                           data-bulk-target="box" data-action="bulk#count"></td>
              <% end %>
              <td>
                <%= link_to company.name, company_path(company) %>
                <%= tracking_badge(company.tracking) if company.dismissed? && @tab == "all" %>
                <div class="small"><%= domain_link(company) %></div>
              </td>
              <td><%= careers_page_cell(company) %></td>
              <td><%= roles_summary(company, @roles) %></td>
              <td>
                <% if (application = @applications[company.id]) %>
                  <%= link_to stage_badge(application.stage), application_path(application) %>
                <% else %>
                  <span class="muted">—</span>
                <% end %>
              </td>
              <td><%= ago(@last_checked[company.id]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
