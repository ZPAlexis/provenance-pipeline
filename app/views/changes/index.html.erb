<% content_for :title, "What changed · Provenance Pipeline" %>
<%# What changed since a check of all tracked companies (1.4; 4e): its sections in five tabs, each with its count, what
    needs you first (new review questions, pages changed a lot); a tab shows only when it holds something. %>
<div class="page-head">
  <div>
    <h1>What changed</h1>
    <p class="sub">What changed since a check of all tracked companies, single checks in between included.</p>
  </div>
</div>

<%= how_this_works do %>
  <p>
    Verdicts that changed, suggestions made and withdrawn, careers pages and boards, descriptions that changed, lists that
    changed a lot, new review questions, and refused writes, since the point you compare from: what a check of all tracked
    companies found and since, or since one ended.
  </p>
<% end %>

<%= form_with url: changes_path, method: :get, class: "check-form" do %>
  <label class="small">Compare from
    <%= select_tag :from, options_for_select(@points.map { |point| [ point.label, point.key ] }, @point.key) %>
  </label>
  <%= submit_tag "Show", class: "btn small", name: nil %>
  <span class="muted small">Since <%= @point.at.utc.strftime("%Y-%m-%d %H:%M UTC") %> (<%= ago(@point.at) %>).</span>
<% end %>

<% verdicts = { "not_found" => "No longer listed", "verified_live" => "Listed", "inaccessible" => "Couldn't confirm",
                "pending" => "Back to no answer" }.filter_map { |state, heading| [ heading, @changes.verdicts.fetch(state, []) ] if @changes.verdicts[state]&.any? } %>
<% suggestions = [ [ "New suggestions", @changes.suggested ], [ "Suggestions withdrawn", @changes.withdrawn ] ].select { |_, events| events.any? } %>
<% pages = [ [ "Careers pages", @changes.careers_pages ], [ "Boards", @changes.boards ] ].select { |_, events| events.any? } %>
<% descriptions = @changes.descriptions %>
<% questions = @changes.questions %>
<% refused = @changes.refused %>
<% groups = [ [ "needs-you", "Needs you", questions.size + @changes.lists.size ],
              [ "listings", "Listings", verdicts.sum { |_, events| events.size } ],
              [ "suggestions", "Suggestions", suggestions.sum { |_, events| events.size } ],
              [ "pages", "Pages and descriptions", pages.sum { |_, events| events.size } + descriptions.size ],
              [ "refused", "Refused writes", refused.size ] ].select { |_, _, count| count.positive? } %>

<% if groups.empty? %>
  <p class="empty">Nothing changed since then.</p>
<% else %>
<div data-controller="tabs">
<%= page_tabs(groups.map { |id, label, count| [ id, safe_join([ "#{label} ", tag.span(count, class: "count") ]) ] }, label: "What changed") %>
<% first = groups.first.first %>

<% if groups.any? { |id, _| id == "needs-you" } %>
<%= tab_panel "needs-you", first: first == "needs-you" do %>
  <% if questions.any? %>
    <h3 id="new-review-questions">New review questions <span class="muted">(<%= questions.size %>)</span></h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Raised</th><th>Kind</th><th>Question</th><th>Now</th></tr></thead>
        <tbody>
          <% questions.each do |item| %>
            <tr>
              <td><%= ago(item.created_at) %></td>
              <td><span class="badge"><%= review_kind_label(item.kind) %></span></td>
              <td><%= review_question(item) %></td>
              <td><%= item.status == "open" ? link_to("Open: decide it", review_path(kind: item.kind)) : tag.span(item.status == "left" ? "Left as is" : "Decided", class: "muted") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @changes.lists.any? %>
    <h3 id="pages-changed-a-lot">Pages changed a lot <span class="muted">(<%= @changes.lists.size %>)</span></h3>
    <p class="muted small">
      Between two whole reads of the same page, at least half its roles gone or half of them new, and at least
      <%= Verifier::ListChange::AT_LEAST %> either way: often a different page now. Each is a question on the Review page.
    </p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Company</th><th class="num">Gone</th><th class="num">New</th><th>Between</th><th>Page</th></tr></thead>
        <tbody>
          <% @changes.lists.each do |change| %>
            <tr>
              <td><%= link_to change.company.name, company_path(change.company) %></td>
              <td class="num"><%= change.gone %> of <%= change.before_size %></td>
              <td class="num"><%= change.added %> of <%= change.after_size %></td>
              <td class="nowrap"><%= change.before.checked_at.to_date %> → <%= change.after.checked_at.to_date %></td>
              <td><%= outside_link(change.url) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
<% end %>

<% if verdicts.any? %>
<%= tab_panel "listings", first: first == "listings" do %>
  <% verdicts.each do |heading, events| %>
    <h3 id="<%= heading.parameterize %>"><%= heading %> <span class="muted">(<%= events.size %>)</span></h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>When</th><th>Role</th><th>Company</th><th>Change</th><th>By</th><th>Why</th></tr></thead>
        <tbody>
          <% events.each do |event| %>
            <tr>
              <td><%= ago(event.occurred_at) %></td>
              <td><%= event_subject(event) %></td>
              <td><%= link_to(event.target.company.name, company_path(event.target.company)) if event.target %></td>
              <td class="nowrap"><%= change_summary(event) %></td>
              <td><%= actor_cell(event) %></td>
              <td class="reason"><%= event.reasoning.to_s.truncate(220) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
<% end %>

<% if suggestions.any? %>
<%= tab_panel "suggestions", first: first == "suggestions" do %>
  <% suggestions.each do |heading, events| %>
    <h3 id="<%= heading.parameterize %>"><%= heading %> <span class="muted">(<%= events.size %>)</span></h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>When</th><th>Role</th><th>Company</th><th>Why</th></tr></thead>
        <tbody>
          <% events.each do |event| %>
            <% company = event.target&.company || Company.find_by(id: event.changes_made.dig("company_id", 0)) %>
            <tr>
              <td><%= ago(event.occurred_at) %></td>
              <td><%= event_subject(event) %></td>
              <td><%= link_to(company.name, company_path(company)) if company %></td>
              <td class="reason"><%= event.reasoning.to_s.truncate(220) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
<% end %>

<% if pages.any? || descriptions.any? %>
<%= tab_panel "pages", first: first == "pages" do %>
  <% pages.each do |heading, events| %>
    <h3 id="<%= heading.parameterize %>"><%= heading %> <span class="muted">(<%= events.size %>)</span></h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>When</th><th>Company</th><th>Change</th><th>By</th><th>Why</th></tr></thead>
        <tbody>
          <% events.each do |event| %>
            <tr>
              <td><%= ago(event.occurred_at) %></td>
              <td><%= event_subject(event) %></td>
              <td class="muted"><%= company_change(event) %></td>
              <td><%= actor_cell(event) %></td>
              <td class="reason"><%= event.reasoning.to_s.truncate(220) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if descriptions.any? %>
    <h3 id="descriptions-changed">Descriptions changed <span class="muted">(<%= descriptions.size %>)</span></h3>
    <p class="muted small">A role whose own page now says something else: often edited or reposted. Earlier versions are on its page.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Read</th><th>Role</th><th>Company</th><th class="num">Words now</th></tr></thead>
        <tbody>
          <% descriptions.each do |version| %>
            <tr>
              <td><%= ago(version.first_read_at) %></td>
              <td><%= link_to version.posting.role_title, role_path(version.posting) %></td>
              <td><%= link_to version.posting.company.name, company_path(version.posting.company) %></td>
              <td class="num"><%= number_with_delimiter(version.words) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
<% end %>

<% if refused.any? %>
<%= tab_panel "refused", first: first == "refused" do %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>When</th><th>By</th><th>On</th><th>Why</th></tr></thead>
      <tbody>
        <% refused.each do |event| %>
          <tr>
            <td><%= ago(event.occurred_at) %></td>
            <td><%= actor_cell(event) %></td>
            <td><%= event_subject(event) %></td>
            <td class="reason"><%= event.reasoning.to_s.delete_prefix("Denied: ") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
<% end %>
</div>
<% end %>
